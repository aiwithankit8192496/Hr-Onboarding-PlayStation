# HTTPS front door for docker-compose.aws.yml (see DEPLOY_AWS.md).
# The two names come from .env (ONBOARD_DOMAIN, HR_DOMAIN); both must point at the instance's
# Elastic IP before the first start, or Caddy cannot get its certificates.

# Browser-side protection for pages that show or collect PAN, Aadhaar and bank details.
# No Content-Security-Policy: the pages compile their JSX in the browser (Babel), which needs unsafe-eval.
(security) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(self), microphone=(), geolocation=()"
		# Never keep ID documents or personal data in the browser cache or a shared proxy
		Cache-Control "no-store"
		-Server
	}
}

{$ONBOARD_DOMAIN} {
	import security
	reverse_proxy onboarding:8000
}

{$HR_DOMAIN} {
	import security
	reverse_proxy hr:8001
}
